{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/omhl-hook.sh", "session-start"],
            "timeout": 15
          },
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/omhl-hook.sh", "version-check"],
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^oh-my-hexflow:",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/omhl-hook.sh", "subagent-start"],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/omhl-hook.sh", "spec-lock"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Monitor|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/omhl-hook.sh", "agent-role"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/omhl-hook.sh", "command-guard"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^mcp__.+__merge_pull_request$",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/omhl-hook.sh", "mcp-merge-guard"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^mcp__.+__(push_files|create_or_update_file|delete_file)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/omhl-hook.sh", "mcp-write-warning"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/omhl-hook.sh", "branch-birth"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
