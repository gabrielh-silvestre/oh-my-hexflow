{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "omhl",
            "args": ["hook", "session-start"],
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "omhl hook spec-lock || exit 2",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Monitor|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "omhl hook agent-role || exit 1",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
