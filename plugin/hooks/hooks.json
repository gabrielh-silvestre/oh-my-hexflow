{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/omhl",
            "args": ["hook", "session-start"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
