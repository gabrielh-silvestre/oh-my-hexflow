{
  "hooks": {
    "SubagentStart": [
      {
        "hooks": [
          { "type": "command", "command": "sh", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/log-stdin.sh", "SubagentStart"], "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "sh", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/log-stdin.sh", "PreToolUse"], "timeout": 10 }
        ]
      }
    ]
  }
}
