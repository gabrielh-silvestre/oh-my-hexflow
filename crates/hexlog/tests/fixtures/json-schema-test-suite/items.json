[{"description":"a schema given for items","schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","items":{"type":"integer"}},"tests":[{"description":"valid items","data":[1,2,3],"valid":true},{"description":"wrong type of items","data":[1,"x"],"valid":false},{"description":"ignores non-arrays","data":{"foo":"bar"},"valid":true},{"description":"JavaScript pseudo-array is valid","data":{"0":"invalid","length":1},"valid":true}]},{"description":"items with boolean schema (true)","schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","items":true},"tests":[{"description":"any array is valid","data":[1,"foo",true],"valid":true},{"description":"empty array is valid","data":[],"valid":true}]},{"description":"items with boolean schema (false)","schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","items":false},"tests":[{"description":"any non-empty array is invalid","data":[1,"foo",true],"valid":false},{"description":"empty array is valid","data":[],"valid":true}]},{"description":"nested items","schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"array","items":{"type":"array","items":{"type":"array","items":{"type":"array","items":{"type":"number"}}}}},"tests":[{"description":"valid nested array","data":[[[[1]],[[2],[3]]],[[[4],[5],[6]]]],"valid":true},{"description":"nested array with invalid type","data":[[[["1"]],[[2],[3]]],[[[4],[5],[6]]]],"valid":false},{"description":"not deep enough","data":[[[1],[2],[3]],[[4],[5],[6]]],"valid":false}]},{"description":"items with null instance elements","schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","items":{"type":"null"}},"tests":[{"description":"allows null elements","data":[null],"valid":true}]}]